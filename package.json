{
  "name": "api-dich-anh",
  "version": "1.0.0",
  "description": "REST API OCR + dich thuat anh sang van ban su dung Tesseract.js va Google Gemini",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:reading-order": "tsx --test tests/reading-order.test.ts",
    "test:cjk-scoring": "tsx --test tests/cjk-scoring.test.ts",
    "test:document-rendering": "tsx --test tests/document-rendering.test.ts",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "cleanup": "npm prune && npm dedupe"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "google-translate-api-x": "^10.7.3",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.22.3",
    "prisma": "^6.19.3",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^6.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
