{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://reasoning-agriculture-observed-remind.trycloudflare.com/api/:match*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/manifest.json",
      "destination": "/public/manifest.json"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
