{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://uncapped-moneywise-wages.ngrok-free.dev/api/:match*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/manifest.json",
      "destination": "/public/manifest.json"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
